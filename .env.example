# Copy this file to .env and fill it in. A variable already set in the environment wins over .env.
# Comments go on their own line: text after a value would become part of the value.

# OpenRouter API key. Leave it empty to run in scripted mode (no LLM; the browser voice speaks).
OPENROUTER_API_KEY=

# The code everyone types on the sign-in card.
ACCESS_CODE=letmein

# Signs the sign-in cookie. Use a long random string anywhere other than your own machine.
SESSION_SECRET=dev-secret-change-me

# Where progress is stored. Postgres later: postgresql+psycopg://user:password@host/dbname
DATABASE_URL=sqlite:///data/tutor.db

# auto = use the LLM when a key is set; scripted = never call the LLM, even with a key.
LLM_MODE=auto

# Turns allowed per day, across all students together.
MAX_TURNS_PER_DAY=2000

# OpenRouter text-to-speech voice.
TTS_VOICE=Kore

# Language of the student's speech, for speech-to-text.
STT_LANGUAGE=en

# true when the site is served over https (marks the sign-in cookie Secure).
HTTPS_ONLY=false
